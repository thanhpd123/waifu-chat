# Sao chép thành `.env` khi chạy local. Trên Vercel: Project → Settings → Environment Variables.

# ---- Bộ não của Kei (chọn 1) ----
# Gemini có gói MIỄN PHÍ: lấy key tại https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI (TRẢ PHÍ) — bỏ comment nếu muốn dùng
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# ---- Giọng nói ----
# edge-tts: giọng nữ miễn phí, không cần key (vi-VN-HoaiMyNeural…). 0 để tắt.
EDGE_TTS_FALLBACK=1

# Múi giờ cho câu "mấy giờ rồi?" ở chế độ offline
WAIFU_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Đăng nhập + lưu cuộc trò chuyện (Supabase, tuỳ chọn) ----
# Bỏ trống → không cần đăng nhập, lịch sử lưu trong trình duyệt.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# (hoặc NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
# VITE_ENABLE_GOOGLE_LOGIN=1     # chỉ bật sau khi cấu hình provider Google trong Supabase
# KEI_REQUIRE_LOGIN=0            # cho phép gọi /api mà không cần đăng nhập
